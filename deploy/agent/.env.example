# 构建版本号，会写入 Agent 的 agent_version。
RIVO_VERSION=dev

# Agent 镜像名称。
RIVO_AGENT_IMAGE=rivo-agent

# Agent 镜像标签。
RIVO_IMAGE_TAG=latest

# Agent 容器名称。
RIVO_AGENT_CONTAINER=rivo-agent

# Master TCP 地址，格式是 host:port。
# 如果 Agent 和 Master 在同一台宿主机并且 Agent 使用 host 网络，可以使用 127.0.0.1:9443。
# 如果跨服务器部署，填写 Master 的公网 IP 或内网 IP，例如 1.2.3.4:9443。
RIVO_MASTER_ADDR=127.0.0.1:9443

# Agent 连接 Master 使用的密钥，必须和 Master config.yaml 里的 tcp.secret_key 一致。
# 必须是 Base64，且解码后不少于 32 字节。可用 openssl rand -base64 32 生成。
RIVO_SECRET_KEY=replace-with-base64-encoded-random-key
