# 构建版本号，会传入 Docker build。正式发布可以改成 v1.0.0 这类版本。
RIVO_VERSION=dev

# Master 镜像名称。
RIVO_MASTER_IMAGE=rivo-master

# Master 镜像标签。
RIVO_IMAGE_TAG=latest

# Master 容器名称。
RIVO_MASTER_CONTAINER=rivo-master

# Master 运行配置文件路径，会挂载到容器内 /app/config.yaml。
# 如果在 devcontainer 里连接宿主机 Docker，建议改成宿主机绝对路径。
RIVO_MASTER_CONFIG_FILE=./depoly/master/config.yaml

# Master 面板和 HTTP API 暴露到宿主机的端口。
RIVO_HTTP_PORT=8080

# Master 接收 Agent TCP 长连接的端口。
RIVO_TCP_PORT=9443

# 容器时区。
TZ=Asia/Shanghai

# 数据库类型：sqlite 或 mysql。
# sqlite 模式只启动 Master 容器；mysql 模式会通过 Makefile 自动启用 MySQL profile。
RIVO_DATABASE_DRIVER=sqlite

# 数据库连接地址。
# sqlite 示例：data/rivo.db，文件会保存在容器 /app/data 下的 Docker volume 中。
# mysql 示例：rivo:replace-with-database-password@tcp(mysql:3306)/rivo?charset=utf8mb4&parseTime=True&loc=Local
RIVO_DATABASE_DSN=data/rivo.db

# 是否启动时自动执行 GORM AutoMigrate。开发阶段建议 true，正式环境可按需关闭。
RIVO_DATABASE_AUTO_MIGRATE=true

# MySQL 镜像标签，仅 RIVO_DATABASE_DRIVER=mysql 时使用。
MYSQL_IMAGE_TAG=8.4

# MySQL 容器名称，仅 RIVO_DATABASE_DRIVER=mysql 时使用。
RIVO_MYSQL_CONTAINER=rivo-mysql

# MySQL root 密码，仅 RIVO_DATABASE_DRIVER=mysql 时使用。
MYSQL_ROOT_PASSWORD=replace-with-root-database-password

# 自动创建的业务数据库名称，仅 RIVO_DATABASE_DRIVER=mysql 时使用。
MYSQL_DATABASE=rivo

# 自动创建的业务数据库用户名，仅 RIVO_DATABASE_DRIVER=mysql 时使用。
MYSQL_USER=rivo

# 自动创建的业务数据库密码，仅 RIVO_DATABASE_DRIVER=mysql 时使用。
MYSQL_PASSWORD=replace-with-database-password

# MySQL 暴露到宿主机的端口，仅 RIVO_DATABASE_DRIVER=mysql 时使用。
MYSQL_PORT=3306
